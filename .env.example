# Copy to .env and adjust for your workspace. Used by run_local.sh for local dev.
# The app authenticates via this CLI profile — no tokens are stored in the repo.
DATABRICKS_CONFIG_PROFILE=<your-databricks-cli-profile>
LAKEBASE_PROJECT=<your-lakebase-autoscaling-project>
LAKEBASE_BRANCH=production
MEMORY_SCHEMA=fincoach
SERVING_ENDPOINT_NAME=databricks-claude-sonnet-5
EMBEDDING_ENDPOINT=databricks-gte-large-en
EMBEDDING_DIMS=1024
PORT=8000
